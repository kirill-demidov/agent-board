<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>            <string>Agent Board</string>
  <key>CFBundleDisplayName</key>     <string>Agent Board</string>
  <key>CFBundleIdentifier</key>      <string>com.agentboard.app</string>
  <key>CFBundleExecutable</key>      <string>AgentBoard</string>
  <key>CFBundleIconFile</key>        <string>AppIcon</string>
  <key>CFBundlePackageType</key>     <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>0.2.0</string>
  <key>LSMinimumSystemVersion</key>  <string>13.0</string>
  <key>NSHighResolutionCapable</key> <true/>
  <!-- Настройки сборки. LaunchServices кладёт их в окружение приложения, оно
       передаёт их серверу; main.swift не перекрывает уже заданное.
       tmux берём системный и сокет default — тот же, что у tmux из терминала,
       иначе доска не увидит сессии, поднятые руками. -->
  <key>LSEnvironment</key>
  <dict>
    <key>AGENTBOARD_SELFNAME</key>     <string>0</string>
    <key>AGENTBOARD_TERMINAL</key>     <string>Warp</string>
    <key>AGENTBOARD_TMUX</key>         <string>/opt/homebrew/bin/tmux</string>
    <key>AGENTBOARD_TMUX_SOCKET</key>  <string>default</string>
  </dict>
</dict>
</plist>
